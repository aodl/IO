#!/usr/bin/env bash
set -euo pipefail

package="${1:?usage: build-canister <package> [release|debug]}"
profile="${2:-release}"

case "$profile" in
  release)
    release_cargo_home="${CARGO_HOME:-${HOME:?HOME is required when CARGO_HOME is unset}/.cargo}"
    if [[ "${release_cargo_home}" != /* ]]; then
      echo "release CARGO_HOME must be absolute: ${release_cargo_home}" >&2
      exit 2
    fi
    # rustc otherwise embeds the builder-specific Cargo registry root in panic
    # locations and Wasm name metadata. Own the complete release flag input and
    # map that root to one stable virtual path on every builder.
    unset RUSTFLAGS
    export CARGO_ENCODED_RUSTFLAGS="--remap-path-prefix=${release_cargo_home}=/io/cargo-home"
    if [[ "$package" == "io-frontend" ]]; then
      npm run build:frontend
    fi
    cargo build -p "$package" --release --target wasm32-unknown-unknown
    profile_dir="release"
    artifact_dir="release-artifacts"
    ;;
  debug)
    if [[ "$package" == "io-frontend" ]]; then
      npm run build:frontend
    fi
    cargo build -p "$package" --target wasm32-unknown-unknown
    profile_dir="debug"
    artifact_dir="debug-artifacts"
    ;;
  *)
    echo "unknown build profile: $profile" >&2
    exit 2
    ;;
esac

crate_name="${package//-/_}"
wasm="target/wasm32-unknown-unknown/${profile_dir}/${crate_name}.wasm"
if [[ ! -f "$wasm" ]]; then
  echo "expected wasm artifact not found: $wasm" >&2
  exit 1
fi

mkdir -p "$artifact_dir"
raw_out="${artifact_dir}/${crate_name}.wasm"
gz_out="${raw_out}.gz"
rm -f "$raw_out" "$gz_out" "${raw_out}.sha256" "${gz_out}.sha256"
cp "$wasm" "$raw_out"
gzip -n -c "$raw_out" > "$gz_out"
sha256sum "$raw_out" > "${raw_out}.sha256"
sha256sum "$gz_out" > "${gz_out}.sha256"
echo "$raw_out"
echo "$gz_out"
