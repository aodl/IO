#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
: "${POCKET_IC_BIN:?set POCKET_IC_BIN to the pocket-ic-server binary}"
export IO_REAL_SNS_WASM_DIR="${IO_REAL_SNS_WASM_DIR:-${ROOT}/.real-canister-wasms}"
export IO_REAL_SNS_WASM_MANIFEST="${IO_REAL_SNS_WASM_MANIFEST:-${ROOT}/tests/e2e_real_canisters/wasms.local.toml}"
export IO_POCKETIC_RUN_ID="io-real-framework-${$}-$(date +%s%N)"
echo "IO_POCKETIC_RUN_ID=${IO_POCKETIC_RUN_ID}"

cleanup_pocketic() {
  local current_user
  current_user="$(id -un)"
  ps -u "${current_user}" -o pid=,ppid=,stat=,cmd= \
    | awk '/pocket-ic/ && /--port-file \/tmp\/pocket_ic_/ { print $1 }' \
    | while read -r pid; do
        [[ -z "${pid}" ]] && continue
        if [[ ! -r "/proc/${pid}/environ" ]]; then
          continue
        fi
        if ! tr '\0' '\n' <"/proc/${pid}/environ" 2>/dev/null \
          | grep -Fxq "IO_POCKETIC_RUN_ID=${IO_POCKETIC_RUN_ID}"; then
          continue
        fi
        kill "${pid}" 2>/dev/null || true
      done
}

run_ignored_test() {
  local test_name="$1"
  cleanup_pocketic
  cargo test -p e2e-real-canisters "${test_name}" -- --ignored --nocapture
  cleanup_pocketic
}

trap cleanup_pocketic EXIT

"${ROOT}/tools/scripts/fetch-real-canister-artifacts"

cd "${ROOT}"
for test_name in \
  real_sns_ledger_index_smoke \
  real_sns_ledger_index_same_wasm_upgrade_preserves_balances_history_and_duplicates \
  real_nns_sns_wasm_canister_responds_to_basic_queries \
  real_nns_sns_wasm_bootstrapped_by_pocketic_icp_features_contains_all_sns_wasm_slots \
  real_sns_w_governance_wasm_publication_payload_sizes_are_understood \
  real_sns_w_publishes_large_governance_wasm_via_gzipped_nns_proposal \
  real_sns_w_publishes_root_governance_ledger_index_swap_archive_via_nns \
  real_sns_lifecycle_deploys_sns_via_sns_w \
  real_sns_swap_opens_with_expected_parameters \
  real_sns_participant_can_fund_swap_account_and_refresh_buyer_tokens \
  real_sns_swap_observes_direct_participation \
  real_sns_swap_commits_after_minimum_participation \
  real_sns_swap_finalizes_successfully_and_preserves_canister_ids \
  real_sns_finalized_governance_list_neurons_returns_participant_neuron \
  real_sns_finalized_governance_neuron_controller_matches_participant \
  real_sns_finalized_governance_neuron_dissolve_delay_matches_basket \
  real_sns_finalized_governance_multiple_participants_create_distinct_neurons \
  real_sns_finalized_governance_no_duplicate_neuron_ids \
  real_sns_finalized_governance_pagination_does_not_drop_neurons \
  real_sns_user_stakes_io_normal_path_after_sns_w_finalization \
  real_sns_user_topup_increases_existing_neuron_after_sns_w_finalization \
  real_sns_user_can_stake_multiple_neurons_after_finalization \
  real_sns_minimum_stake_is_enforced_after_finalization \
  real_sns_dissolve_delay_below_two_weeks_is_ineligible_after_finalization \
  real_sns_dissolve_delay_at_two_weeks_is_eligible_after_finalization \
  real_sns_dissolve_delay_above_two_weeks_cannot_be_applied_after_finalization \
  real_sns_dissolving_neuron_is_excluded_if_policy_requires_after_finalization \
  real_sns_stop_dissolving_uses_remaining_delay_and_requires_exact_relock_after_finalization \
  real_sns_no_closed_proposals_participation_factor_defaults_to_one_after_finalization \
  real_sns_user_votes_yes_and_ballot_is_observed_after_finalization \
  real_sns_user_votes_no_and_ballot_is_observed_after_finalization \
  real_sns_non_voter_gets_lower_participation_factor_after_finalization \
  real_sns_following_vote_counts_for_participation_if_policy_allows_after_finalization \
  real_sns_proposal_rejection_fee_is_100_io_if_configured_after_finalization \
  real_sns_root_lists_application_subnet_dapp_after_finalization \
  real_sns_root_can_upgrade_test_app_canister_after_finalization \
  real_sns_root_rejects_non_dapp_canister_after_finalization
do
  run_ignored_test "${test_name}"
done
cargo build -p io-stream-manager -p io-nns-neuron-manager -p io-historian --target wasm32-unknown-unknown
for test_name in \
  io_real_stack_installs_stream_manager_on_application_subnet \
  io_real_stack_installs_nns_neuron_manager_on_application_subnet \
  io_real_stack_installs_historian_on_application_subnet \
  io_stream_manager_real_finalized_sns_list_neurons_updates_active_staked_io \
  io_stream_manager_real_jupiter_deposit_scanned_from_real_icp_index \
  io_stream_manager_real_two_week_maturity_5_icp_issues_exact_backed_reward_pool \
  io_stream_manager_real_two_week_maturity_rewards_only_eligible_stakers \
  real_finalized_sns_four_role_reward_reconciles_exactly_once \
  real_finalized_sns_zero_recipient_reward_retains_full_pool_as_dust \
  io_stream_manager_real_sns_topup_increases_active_staked_io \
  io_stream_manager_real_redemption_pays_icp_on_real_local_ledger \
  io_stream_manager_real_redemption_rounding_fee_dust_accounted \
  io_stream_manager_real_redemption_below_io_return_fee_fails_closed \
  io_stream_manager_real_redemption_rejects_insufficient_redeemable_supply \
  io_stream_manager_real_redemption_after_index_lag_waits_or_fails_closed \
  real_stack_rejected_refund_too_old_waits_for_index_proof_no_double_refund \
  io_stream_manager_real_redemption_after_holder_yield_is_higher_than_genesis \
  io_stream_manager_real_redemption_after_staker_rewards_preserves_rate \
  real_stack_same_wasm_upgrade_preserves_operation_journal \
  real_stack_same_wasm_upgrade_preserves_scheduler_cursors \
  real_stack_same_wasm_upgrade_preserves_processed_tx_set \
  real_sns_w_accepts_root_ledger_index_swap_archive_wasms_direct_test_path \
  real_sns_w_lists_published_wasms_direct_test_path \
  real_sns_w_rejects_wrong_hash_or_wrong_type_direct_test_path \
  real_sns_w_publication_is_idempotent_or_fails_safely_direct_test_path \
  real_sns_w_accepts_root_governance_ledger_index_swap_archive_wasms_direct_test_path \
  real_sns_root_control_uses_application_subnet_canister_direct_root_path \
  real_sns_governance_direct_empty_state_lists_no_neurons_or_proposals \
  real_sns_user_stakes_io_normal_path_and_list_neurons_observes_it_direct_governance_path \
  real_sns_user_topup_increases_existing_neuron_stake_direct_governance_path \
  real_sns_minimum_stake_is_enforced_direct_governance_path \
  real_sns_dissolve_delay_boundaries_are_visible_direct_governance_path \
  real_canister_e2e_icp_to_io_stake_reward_redemption \
  real_sns_governance_staking_smoke
do
  run_ignored_test "${test_name}"
done
echo "real-framework-e2e completed successfully"
