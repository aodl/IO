type Account = record { owner : principal; subaccount : opt blob };
type NamedAccount = record { name : text; account : Account };
type CanisterRole = variant {
  StreamManager;
  NnsManager;
  Historian;
  Frontend;
  SnsGovernance;
  SnsRoot;
  SnsLedger;
  SnsIndex;
  SnsSwap;
};
type ExpectedModule = record {
  role : CanisterRole;
  canister_id : principal;
  wasm_sha256 : blob;
};
type ObservationConfig = record {
  stream_manager : principal;
  nns_manager : principal;
  sns_root : principal;
  sns_governance : principal;
  sns_ledger : principal;
  sns_index : principal;
  icp_ledger : principal;
  nns_governance : principal;
  two_year_neuron_id : nat64;
  protocol_io_reserve : Account;
  liquid_icp_reserve : Account;
  nonredeemable_governance_io_accounts : vec NamedAccount;
  history_accounts : vec NamedAccount;
  expected_modules : vec ExpectedModule;
  reward_share_capable_governance_sha256 : opt blob;
  refresh_interval_seconds : nat64;
};
type ObservationFreshness = variant {
  Fresh;
  Stale;
  Missing;
  ErrorRetryable;
  PrelaunchNotConfigured;
};
type SourceHealth = record {
  source : text;
  freshness : ObservationFreshness;
  last_attempt_timestamp_nanos : opt nat64;
  last_success_timestamp_nanos : opt nat64;
  error : opt text;
};
type DataCompleteness = record {
  total_io_supply : bool;
  protocol_reserve_io : bool;
  nonredeemable_governance_io : bool;
  claim_io_supply : bool;
  claim_backing : bool;
  active_backing_io : bool;
  active_reward_io : bool;
  claim_rate : bool;
};
type ClaimRateSnapshot = record {
  backing_numerator_e8s : nat;
  claim_denominator_e8s : nat;
  available_liquid_e8s : nat;
  observed_at_timestamp_nanos : nat64;
};
type PooledTargetDelta = variant { UnderTarget : nat; AtTarget; OverTarget : nat };
type ProtocolSnapshot = record {
  generation : nat64;
  total_io_supply_e8s : opt nat;
  protocol_reserve_io_e8s : opt nat;
  nonredeemable_governance_io_e8s : opt nat;
  claim_io_supply_e8s : opt nat;
  liquid_claim_backing_e8s : opt nat;
  pooled_parent_principal_e8s : opt nat;
  live_child_net_backing_e8s : opt nat;
  in_transit_backing_e8s : opt nat;
  total_claim_backing_e8s : opt nat;
  claim_rate : opt ClaimRateSnapshot;
  active_backing_io_e8s : opt nat;
  active_reward_io_e8s : opt nat;
  pooled_target_e8s : opt nat;
  pooled_target_delta : opt PooledTargetDelta;
  live_cohort_count : opt nat32;
  oldest_ready_at_seconds : opt nat64;
  permanent_productive_capital_e8s : opt nat;
  observed_at_timestamp_nanos : opt nat64;
  completeness : DataCompleteness;
};
type Lifecycle = variant { Paused; Ready };
type RewardEventClassification = variant {
  ProposalBearing;
  NoProposalFallback;
  ZeroEligibleParticipation;
  MissedSkipped;
};
type RewardEventId = record { end_timestamp_seconds : nat64; round : nat64 };
type StreamStatus = record {
  lifecycle : Lifecycle;
  operation_kind : opt text;
  operation_phase : opt text;
  latest_entitlement_batch_generation : nat64;
  latest_processed_reward_event : opt RewardEventId;
  latest_reward_event_classification : opt RewardEventClassification;
  accumulated_eligible_credit : nat;
  accumulated_policy_credit : nat;
  processed_reward_event_count : nat64;
  missed_reward_event_count : nat64;
  reward_work_due : bool;
  reward_processing_paused : bool;
  governance_parameters_fresh : bool;
  pending_entitlement_batch_eligible_credit : opt nat;
  pending_entitlement_batch_policy_credit : opt nat;
  latest_reconciliation_checkpoint : opt ReconciliationProjection;
  observed_at_timestamp_nanos : nat64;
};
type ReconciliationProjection = record {
  generation : nat64;
  observed_at_nanos : nat64;
  claim_supply_e8s : nat;
  liquid_backing_e8s : nat;
  pooled_backing_e8s : nat;
  unwinding_backing_e8s : nat;
  transit_backing_e8s : nat;
  total_claim_backing_e8s : nat;
  active_backing_io_e8s : nat;
  active_reward_io_e8s : nat;
  live_cohort_count : nat32;
  oldest_ready_at_seconds : opt nat64;
  pooled_target_e8s : nat;
  observed_pooled_e8s : nat;
};
type NnsManagerStatus = record {
  lifecycle : Lifecycle;
  active_operation : opt text;
  permanent_maturity_baseline_reconciled : bool;
  latest_started_two_week_generation : nat64;
  latest_completed_two_week_generation : nat64;
  latest_pooled_target : opt PooledTargetObservation;
  live_child_physical_principal_e8s : nat;
  live_child_net_backing_e8s : nat;
  live_child_committed_fee_liability_e8s : nat;
  observed_at_timestamp_nanos : nat64;
};
type TwoWeekTargetStatus = variant {
  UnderTarget;
  AtTarget;
  AtTargetWithinUnwindTolerance;
  OverTarget;
};
type PooledTargetObservation = record {
  target_e8s : nat;
  status : TwoWeekTargetStatus;
};
type NnsNeuronRole = variant { TwoYearProtected };
type NnsNeuronObservation = record {
  role : NnsNeuronRole;
  neuron_id : nat64;
  stake_e8s : nat64;
  staked_maturity_e8s : opt nat64;
  dissolve_delay_seconds : nat64;
  state : int32;
};
type NnsGovernanceStatus = record {
  build_metadata : text;
  neurons : vec NnsNeuronObservation;
  observed_at_timestamp_nanos : nat64;
};
type ModuleMatch = variant { Matching; Mismatch; Unavailable; Unknown };
type CanisterObservation = record {
  role : CanisterRole;
  canister_id : principal;
  expected_module_hash : blob;
  observed_module_hash : opt blob;
  module_match : ModuleMatch;
  controllers : opt vec principal;
  observed_at_timestamp_nanos : nat64;
};
type CapabilityState = variant {
  ExpectedGovernanceModuleMatching;
  ModuleMismatch;
  Unavailable;
};
type SnsStatus = record {
  max_number_of_neurons : opt nat64;
  native_initial_reward_rate_basis_points : opt nat64;
  native_final_reward_rate_basis_points : opt nat64;
  latest_reward_event_round : opt nat64;
  latest_reward_event_end_timestamp_seconds : opt nat64;
  settled_proposal_count : opt nat64;
  reward_share_capability : CapabilityState;
  archive_canisters : vec principal;
  observed_at_timestamp_nanos : nat64;
};
type RecentTransaction = record {
  block_index : nat;
  kind : text;
  amount_e8s : opt nat;
  from : opt Account;
  to : opt Account;
  timestamp_nanos : nat64;
};
type AccountHistoryObservation = record {
  name : text;
  account : Account;
  index_balance_e8s : nat;
  newest_transaction_id : opt nat;
  oldest_transaction_id : opt nat;
  transactions : vec RecentTransaction;
};
type IndexStatus = record {
  num_blocks_synced : nat;
  accounts : vec AccountHistoryObservation;
  observed_at_timestamp_nanos : nat64;
};
type PublicStatus = record {
  version : text;
  schema_version : nat32;
  configured : bool;
  refresh_active : bool;
  refresh_generation : nat64;
  last_attempt_timestamp_nanos : opt nat64;
  last_success_timestamp_nanos : opt nat64;
};
type Dashboard = record {
  status : PublicStatus;
  protocol : ProtocolSnapshot;
  source_health : vec SourceHealth;
  canisters : vec CanisterObservation;
  stream : opt StreamStatus;
  nns_manager : opt NnsManagerStatus;
  nns_governance : opt NnsGovernanceStatus;
  sns : opt SnsStatus;
  index : opt IndexStatus;
};

service : (opt ObservationConfig) -> {
  get_dashboard_state : () -> (Dashboard) query;
  get_protocol_snapshot : () -> (ProtocolSnapshot) query;
  get_public_status : () -> (PublicStatus) query;
  get_claim_rate : () -> (opt ClaimRateSnapshot) query;
  version : () -> (text) query;
}
