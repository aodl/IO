type Account = record { owner : principal; subaccount : opt blob };
type Lifecycle = variant { Paused; Ready };
type NnsConfig = record {
  sns_governance : principal;
  stream_manager : principal;
  jupiter : principal;
  icp_ledger : principal;
  nns_governance : principal;
  two_year_neuron_id : nat64;
  two_week_neuron_id : nat64;
  jupiter_account : Account;
  jupiter_staging : Account;
  two_week_maturity_staging : Account;
  stream_liquid_account : Account;
  expected_io_fee_e8s : nat;
  expected_icp_fee_e8s : nat;
  jupiter_fee_float_e8s : nat;
  two_week_fee_float_e8s : nat;
  seeded_two_week_principal_e8s : nat;
  transfer_retry_delay_nanos : nat64;
  ledger_deduplication_window_nanos : nat64;
};
type InitArgs = record { config : NnsConfig };
type NotifyJupiterDepositArgs = record { block_index : nat };
type SetTwoWeekTargetArgs = record { target_e8s : nat; generation : nat64 };
type PrepareTwoWeekMaturityArgs = record {
  cohort_generation : nat64;
  captured_at_timestamp_seconds : nat64;
  closes_at_timestamp_seconds : nat64;
};
type TwoWeekTargetStatus = variant {
  UnderTarget;
  AtTarget;
  AtTargetWithinUnwindTolerance;
  OverTarget;
};
type ApiError = variant {
  Unauthorized;
  Paused;
  Busy;
  Invalid : text;
  Pending : text;
  Stuck : text;
  BelowMaturityThreshold : record { remaining_e8s : nat64; minimum_e8s : nat64 };
  ImplementationIncomplete : text;
};
type JupiterCompleted = record {
  deposit_block : nat;
  gross_e8s : nat;
  stake_e8s : nat;
  liquid_e8s : nat;
  stake_transfer_block : nat;
  liquid_transfer_block : nat;
  stream_receipt_sequence : nat64;
  backed_io_e8s : nat;
  io_transfer_block : nat;
  io_fee_e8s : nat;
  stream_receipt_fingerprint : blob;
  completed_at_nanos : nat64;
};
type JupiterProgress = variant {
  DepositProved;
  StakeTransferPrepared;
  StakeTransferSubmitted;
  StakeTransferSucceeded;
  RefreshSubmitted;
  StakeIncreaseProved;
  ReceiptPermitPrepared;
  LiquidTransferPrepared;
  LiquidTransferSubmitted;
  LiquidTransferSucceeded;
  ReceiptCompletionSubmitted;
  AwaitingStreamSettlement;
  Completed : JupiterCompleted;
  Stuck : text;
};
type MaturityKind = variant { TwoYear; TwoWeek };
type CompletedMaturity = record {
  kind : MaturityKind;
  neuron_id : nat64;
  mint_block : nat;
  nominal_disbursed_maturity_e8s : nat64;
  actual_minted_e8s : nat;
  destination : Account;
  completed_at_nanos : nat64;
};
type MaturityProgress = variant {
  Observed;
  StakeMaturitySubmitted;
  StakeMaturitySucceeded;
  DisburseMaturitySubmitted;
  DisburseMaturitySucceeded;
  AwaitingMintProof;
  MintProved;
  DeliveringTwoWeekReceipt;
  Completed : CompletedMaturity;
  Stuck : text;
};
type UnwindProgress = variant {
  ChildCreated;
  Dissolving;
  MergeBack;
  MergedBack;
  ReadyToDisburse;
  AwaitingTransferProof;
  Completed : record { block_index : nat; liquid_e8s : nat };
  Stuck : text;
};
type NnsProgress = variant {
  Jupiter : JupiterProgress;
  Maturity : MaturityProgress;
  Unwind : UnwindProgress;
  Idle;
};
type Status = record {
  lifecycle : Lifecycle;
  active_operation : opt text;
  latest_target_generation : nat64;
  latest_started_two_week_generation : nat64;
  latest_completed_two_week_generation : nat64;
  active_parent_principal_e8s : nat;
  unwinding_child_principal_e8s : nat;
  has_pending_two_year_maturity : bool;
  has_pending_two_week_maturity : bool;
  has_pending_unwind : bool;
};
service : (InitArgs) -> {
  notify_jupiter_deposit : (NotifyJupiterDepositArgs) -> (variant { Ok : JupiterProgress; Err : ApiError });
  set_two_week_target : (SetTwoWeekTargetArgs) -> (variant { Ok : TwoWeekTargetStatus; Err : ApiError });
  resume : () -> (variant { Ok : NnsProgress; Err : ApiError });
  prove_active_transfer : (nat) -> (variant { Ok : NnsProgress; Err : ApiError });
  start_maturity : (MaturityKind) -> (variant { Ok : MaturityProgress; Err : ApiError });
  prepare_two_week_maturity : (PrepareTwoWeekMaturityArgs) -> (variant { Ok : MaturityProgress; Err : ApiError });
  resume_maturity : (MaturityKind) -> (variant { Ok : MaturityProgress; Err : ApiError });
  prove_maturity_mint : (MaturityKind, nat) -> (variant { Ok : MaturityProgress; Err : ApiError });
  set_paused : (bool) -> (variant { Ok; Err : ApiError });
  get_status : () -> (Status) query;
}
