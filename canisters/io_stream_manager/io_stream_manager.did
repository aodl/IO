type Account = record { owner : principal; subaccount : opt blob };
type Lifecycle = variant { Paused; Ready };
type StreamConfig = record {
  io_ledger : principal;
  icp_ledger : principal;
  nns_manager : principal;
  jupiter_receipt_source : Account;
  two_week_receipt_source : Account;
  jupiter_io_account : Account;
  sns_governance : principal;
  io_reserve : Account;
  liquid_icp : Account;
  excluded_io_accounts : vec Account;
  minimum_redemption_io_e8s : nat;
  expected_io_fee_e8s : nat;
  expected_icp_fee_e8s : nat;
  maximum_request_lifetime_nanos : nat64;
  retry_delay_nanos : nat64;
  ledger_deduplication_window_nanos : nat64;
};
type InitArgs = record { config : StreamConfig; next_cohort_timestamp_seconds : nat64 };
type RedeemArgs = record {
  from_subaccount : opt blob;
  io_amount_e8s : nat;
  min_icp_out_e8s : nat;
  max_io_fee_e8s : nat;
  max_icp_fee_e8s : nat;
  expires_at_nanos : nat64;
  nonce : nat64;
};
type RedemptionResult = record {
  request_fingerprint : blob;
  nonce : nat64;
  io_block : nat;
  icp_block : nat;
  gross_icp_e8s : nat;
  net_icp_e8s : nat;
  io_fee_e8s : nat;
  icp_fee_e8s : nat;
  completed_at_nanos : nat64;
};
type CallerRedemptionState = record {
  next_nonce : nat64;
  last_request_fingerprint : opt blob;
  last_result : opt RedemptionResult;
};
type RedemptionProgress = variant {
  Preparing;
  IoPullSubmitted;
  IoInReserve;
  PayoutSubmitted;
  PayoutSucceeded;
  Completing;
  Completed : RedemptionResult;
  Stuck : text;
};
type ReceiptKind = variant { Jupiter; TwoWeekMaturity };
type PrepareLiquidReceiptArgs = record {
  receipt_sequence : nat64;
  receipt_kind : ReceiptKind;
  source_operation_id : blob;
  liquid_amount_e8s : nat;
  cohort_generation : opt nat64;
};
type LiquidReceiptPermit = record { sequence : nat64; destination : Account; memo : blob };
type CompleteLiquidReceiptArgs = record { receipt_sequence : nat64; block_index : nat };
type RewardMember = record {
  sns_neuron_id : blob;
  account : Account;
  frozen_stake_e8s : nat;
  observed_stake_e8s : nat;
  eligible_closed_proposals : nat64;
  voted_closed_proposals : nat64;
  destination_is_currently_eligible : bool;
};
type RewardCohort = record {
  generation : nat64;
  captured_at_timestamp_seconds : nat64;
  closes_at_timestamp_seconds : nat64;
  target_icp_e8s : nat;
  latest_proposal_id_at_capture : opt nat64;
  open_proposal_ids_at_capture : vec nat64;
  members : vec RewardMember;
};
type JupiterReceiptResult = record {
  request_fingerprint : blob;
  receipt_block : nat;
  backed_io_e8s : nat;
  io_transfer_block : nat;
  io_fee_e8s : nat;
  completed_at_nanos : nat64;
};
type TwoWeekReceiptResult = record {
  request_fingerprint : blob;
  receipt_block : nat;
  backed_io_pool_e8s : nat;
  distributed_io_e8s : nat;
  forfeited_io_e8s : nat;
  rounding_dust_io_e8s : nat;
  total_dust_io_e8s : nat;
  completed_at_nanos : nat64;
};
type CompletedReceiptResult = variant {
  Jupiter : JupiterReceiptResult;
  TwoWeek : TwoWeekReceiptResult;
};
type LiquidReceiptProgress = variant {
  AwaitingReceipt;
  ReceiptProved;
  Settling;
  Completed : CompletedReceiptResult;
  Stuck : text;
};
type StreamProgress = variant {
  Redemption : RedemptionProgress;
  LiquidReceipt : LiquidReceiptProgress;
  Idle;
};
type ApiError = variant {
  Anonymous;
  Unauthorized;
  Paused;
  Busy;
  WrongNonce : record { expected : nat64 };
  NonceAlreadyUsed;
  Invalid : text;
  Ledger : text;
  Pending : text;
  Stuck : text;
};
type Status = record {
  lifecycle : Lifecycle;
  operation_kind : opt text;
  operation_phase : opt text;
  next_nns_receipt_sequence : nat64;
  next_cohort_timestamp_seconds : nat64;
  latest_cohort_generation : nat64;
  has_active_reward_cohort : bool;
  has_pending_reward_cohort : bool;
};
service : (InitArgs) -> {
  redeem : (RedeemArgs) -> (variant { Ok : RedemptionProgress; Err : ApiError });
  prepare_liquid_receipt : (PrepareLiquidReceiptArgs) -> (variant { Ok : LiquidReceiptPermit; Err : ApiError });
  complete_liquid_receipt : (CompleteLiquidReceiptArgs) -> (variant { Ok : LiquidReceiptProgress; Err : ApiError });
  resume : () -> (variant { Ok : StreamProgress; Err : ApiError });
  prove_active_transfer : (nat) -> (variant { Ok; Err : ApiError });
  capture_reward_cohort : () -> (variant { Ok : RewardCohort; Err : ApiError });
  close_reward_cohort : () -> (variant { Ok : RewardCohort; Err : ApiError });
  set_paused : (bool) -> (variant { Ok; Err : ApiError });
  get_status : () -> (Status) query;
  get_caller_redemption_state : () -> (variant { Ok : CallerRedemptionState; Err : ApiError }) query;
}
