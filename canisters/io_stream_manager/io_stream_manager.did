type Account = record { owner : principal; subaccount : opt blob };
type Lifecycle = variant { Paused; Ready };
type StreamConfig = record {
  io_ledger : principal;
  icp_ledger : principal;
  nns_manager : principal;
  jupiter_receipt_source : Account;
  jupiter_io_account : Account;
  sns_governance : principal;
  sns_root : principal;
  expected_sns_governance_module_hash : blob;
  approved_reward_event_duration_seconds : nat64;
  io_reserve : Account;
  liquid_icp : Account;
  nonredeemable_governance_io_accounts : vec Account;
  minimum_redemption_io_e8s : nat;
  expected_io_fee_e8s : nat;
  expected_icp_fee_e8s : nat;
  maximum_request_lifetime_nanos : nat64;
  retry_delay_nanos : nat64;
  ledger_deduplication_window_nanos : nat64;
};
type InitArgs = record { config : StreamConfig };
type RedeemArgs = record {
  from_subaccount : opt blob;
  io_amount_e8s : nat;
  min_icp_out_e8s : nat;
  max_io_fee_e8s : nat;
  max_icp_fee_e8s : nat;
  expires_at_nanos : nat64;
  nonce : nat64;
};
type RedemptionResult = record {
  request_fingerprint : blob;
  nonce : nat64;
  io_block : nat;
  icp_block : nat;
  gross_icp_e8s : nat;
  net_icp_e8s : nat;
  io_fee_e8s : nat;
  icp_fee_e8s : nat;
  completed_at_nanos : nat64;
};
type CallerRedemptionState = record {
  next_nonce : nat64;
  last_request_fingerprint : opt blob;
  last_result : opt RedemptionResult;
};
type RedemptionProgress = variant {
  Preparing;
  IoPullSubmitted;
  IoInReserve;
  PayoutSubmitted;
  PayoutSucceeded;
  Completing;
  Completed : RedemptionResult;
  Stuck : text;
};
type PrepareJupiterReceiptArgs = record {
  receipt_sequence : nat64;
  source_operation_id : blob;
  liquid_amount_e8s : nat;
};
type JupiterReceiptPermit = record { sequence : nat64; destination : Account; memo : blob };
type CompleteJupiterReceiptArgs = record { receipt_sequence : nat64; block_index : nat };
type RewardEventId = record {
  end_timestamp_seconds : nat64;
  round : nat64;
};
type RewardEventClassification = variant {
  ProposalBearing;
  NoProposalFallback;
  ZeroEligibleParticipation;
  MissedSkipped;
};
type RewardEventCredit = record {
  sns_neuron_id : blob;
  destination : Account;
  event_credit : nat;
};
type RewardEntitlementEntry = record {
  sns_neuron_id : blob;
  destination : Account;
  accumulated_eligible_credit : nat;
};
type RewardEventObservation = record {
  event : RewardEventId;
  proposal_count : nat64;
  classification : RewardEventClassification;
  credits : vec RewardEventCredit;
  policy_credit : nat;
  eligible_credit_total : nat;
  observed_at_nanos : nat64;
};
type BackingNotReadyReason = variant {
  Paused;
  Busy;
  ReconciliationPending;
  BelowThreshold;
};
type RewardBackingProgress = variant {
  Pending : record { reason : BackingNotReadyReason };
  MaturityPrepared : record { generation : nat64 };
};
type JupiterReceiptResult = record {
  request_fingerprint : blob;
  receipt_block : nat;
  backed_io_e8s : nat;
  io_transfer_block : nat;
  io_fee_e8s : nat;
  completed_at_nanos : nat64;
};
type JupiterReceiptProgress = variant {
  AwaitingReceipt;
  ReceiptProved;
  Settling;
  Completed : JupiterReceiptResult;
  Stuck : text;
};
type BackingInflowKind = variant { PermanentMaturity; PooledMaturity };
type PrepareBackingInflowArgs = record {
  kind : BackingInflowKind;
  source_operation_id : blob;
  actual_mint_e8s : nat;
  maturity_generation : nat64;
  staging_account : Account;
  mint_block : nat;
  permanent_transfer_fee_e8s : nat;
  claim_transfer_fee_e8s : nat;
  nns_fingerprint : blob;
};
type ClaimRoute = variant { AllLiquid; AllPool; Mixed };
type ClaimRoutePlan = record {
  route : ClaimRoute;
  fee_count : nat8;
  claim_credit : nat;
  liquid_credit : nat;
  pooled_credit : nat;
  target : nat;
  under_target : nat;
  over_target : nat;
};
type RewardAllocation = record { sns_neuron_id : blob; io_e8s : nat };
type AllocationOutcome = record {
  allocations : vec RewardAllocation;
  forfeited_io_e8s : nat;
  rounding_dust_e8s : nat;
};
type TwoWeekSettlementPlan = record {
  route : ClaimRoutePlan;
  permanent_credit : nat;
  maximum_io_pool : nat;
  rewards : AllocationOutcome;
  distributed_io : nat;
  recipient_io_fees : nat;
  post_backing : nat;
  post_claims : nat;
  post_active_backing : nat;
  post_active_reward : nat;
  reward_target : nat;
  snapshot_fingerprint : blob;
};
type FrozenRewardRecipient = record {
  sns_neuron_id : blob;
  destination : Account;
  io_e8s : nat;
};
type FrozenInflowEconomics = variant {
  Permanent : record { route : ClaimRoutePlan };
  Pooled : record {
    settlement : TwoWeekSettlementPlan;
    recipients : vec FrozenRewardRecipient;
  };
};
type BackingInflowPermit = record {
  stream_operation_sequence : nat64;
  source_operation_id : blob;
  actual_mint_e8s : nat;
  maturity_generation : nat64;
  staging_account : Account;
  mint_block : nat;
  permanent_destination : Account;
  pool_destination : Account;
  expected_parent_before_e8s : nat;
  liquid_destination : Account;
  permanent_transfer_fee_e8s : nat;
  claim_transfer_fee_e8s : nat;
  economics : FrozenInflowEconomics;
  nns_fingerprint : blob;
  snapshot_fingerprint : blob;
};
type BackingEffect = variant { PermanentCredit; FirstClaimCredit; PooledCredit };
type ProveBackingEffectArgs = record {
  stream_operation_sequence : nat64;
  effect : BackingEffect;
  block_index : nat;
};
type BackingInflowProgress = variant {
  AwaitingNnsEffects : BackingInflowPermit;
  AwaitingPooledTransfer;
  AwaitingPooledProof : record { block_index : nat };
  SettlingRewards;
  Completed : record { source_operation_id : blob; distributed_io_e8s : nat };
  Stuck : text;
};
type StreamProgress = variant {
  Redemption : RedemptionProgress;
  JupiterReceipt : JupiterReceiptProgress;
  BackingInflow : BackingInflowProgress;
  BackingReconciliation;
  Idle;
};
type ApiError = variant {
  Anonymous;
  Unauthorized;
  Paused;
  Busy;
  WrongNonce : record { expected : nat64 };
  NonceAlreadyUsed;
  Invalid : text;
  Ledger : text;
  Pending : text;
  Stuck : text;
  LiquidityShortfall : record {
    gross_icp_e8s : nat;
    net_icp_e8s : nat;
    available_liquid_e8s : nat;
  };
};
type Status = record {
  lifecycle : Lifecycle;
  operation_kind : opt text;
  operation_phase : opt text;
  next_nns_receipt_sequence : nat64;
  latest_entitlement_batch_generation : nat64;
  latest_processed_reward_event : opt RewardEventId;
  latest_reward_event_classification : opt RewardEventClassification;
  accumulated_entitlements : vec RewardEntitlementEntry;
  accumulated_eligible_credit : nat;
  accumulated_policy_credit : nat;
  processed_reward_event_count : nat64;
  missed_reward_event_count : nat64;
  reward_work_due : bool;
  reward_processing_paused : bool;
  governance_parameters_fresh : bool;
  pending_entitlement_batch_eligible_credit : opt nat;
  pending_entitlement_batch_policy_credit : opt nat;
  latest_reconciliation_checkpoint : opt ReconciliationCheckpoint;
};
type ReconciliationCheckpoint = record {
  generation : nat64;
  event_marker : nat64;
  observed_at_nanos : nat64;
  claim_supply_e8s : nat;
  liquid_backing_e8s : nat;
  pooled_backing_e8s : nat;
  unwinding_backing_e8s : nat;
  transit_backing_e8s : nat;
  total_claim_backing_e8s : nat;
  active_backing_io_e8s : nat;
  active_reward_io_e8s : nat;
  live_cohort_count : nat32;
  oldest_ready_at_seconds : opt nat64;
  pooled_target_e8s : nat;
  observed_pooled_e8s : nat;
  snapshot_fingerprint : blob;
};
service : (InitArgs) -> {
  redeem : (RedeemArgs) -> (variant { Ok : RedemptionProgress; Err : ApiError });
  prepare_jupiter_receipt : (PrepareJupiterReceiptArgs) -> (variant { Ok : JupiterReceiptPermit; Err : ApiError });
  complete_jupiter_receipt : (CompleteJupiterReceiptArgs) -> (variant { Ok : JupiterReceiptProgress; Err : ApiError });
  prepare_backing_inflow : (PrepareBackingInflowArgs) -> (variant { Ok : BackingInflowPermit; Err : ApiError });
  prove_backing_effect : (ProveBackingEffectArgs) -> (variant { Ok : BackingInflowProgress; Err : ApiError });
  resume : () -> (variant { Ok : StreamProgress; Err : ApiError });
  prove_active_transfer : (nat) -> (variant { Ok; Err : ApiError });
  resume_reward_work : () -> (variant { Ok : RewardEventObservation; Err : ApiError });
  resume_reward_backing : () -> (variant { Ok : RewardBackingProgress; Err : ApiError });
  set_paused : (bool) -> (variant { Ok; Err : ApiError });
  validate_set_paused : (bool) -> (variant { Ok : text; Err : text }) query;
  get_status : () -> (Status) query;
  get_caller_redemption_state : () -> (variant { Ok : CallerRedemptionState; Err : ApiError }) query;
}
