type Account = record { owner : principal; subaccount : opt blob };
type Lifecycle = variant { Paused; Ready };
type StreamConfig = record {
  io_ledger : principal;
  io_index : principal;
  icp_ledger : principal;
  nns_manager : principal;
  jupiter_io_account : Account;
  sns_governance : principal;
  sns_root : principal;
  expected_sns_governance_module_hash : blob;
  approved_reward_event_duration_seconds : nat64;
  io_reserve : Account;
  liquid_icp : Account;
  nonredeemable_governance_io_accounts : vec Account;
  minimum_redemption_io_e8s : nat;
  expected_io_fee_e8s : nat;
  expected_icp_fee_e8s : nat;
  redemption_poll_interval_seconds : nat64;
  retry_delay_nanos : nat64;
  ledger_deduplication_window_nanos : nat64;
};
type InitArgs = record { config : StreamConfig };
type RedemptionResult = record {
  source_io_block : nat;
  source_account : Account;
  gross_icp_e8s : nat;
  net_icp_e8s : nat;
  icp_fee_e8s : nat;
  icp_payout_block : nat;
  io_sweep_fee_e8s : nat;
  reserve_sweep_block : nat;
  completed_at_nanos : nat64;
};
type RedemptionProgress = variant {
  Idle;
  Pending;
  RateLimited : record { retry_at_nanos : nat64 };
  Completed : RedemptionResult;
  Stuck : text;
};
type ClaimBackingReceiptKind = variant {
  Jupiter;
  TwoWeek : record { entitlement_generation : nat64 };
};
type PrepareClaimBackingReceiptArgs = record {
  nns_operation_sequence : nat64;
  kind : ClaimBackingReceiptKind;
  net_liquid_credit_e8s : nat;
};
type ClaimBackingReceiptPermit = record {
  stream_operation_sequence : nat64;
  destination : Account;
  amount_e8s : nat;
  memo : blob;
};
type ProveClaimBackingReceiptArgs = record {
  stream_operation_sequence : nat64;
  block_index : nat;
};
type ClaimBackingReceiptResult = record {
  nns_operation_sequence : nat64;
  kind : ClaimBackingReceiptKind;
  liquid_credit_e8s : nat;
  distributed_io_e8s : nat;
  recipient_transfer_block : opt nat;
  io_fee_e8s : nat;
  completed_at_nanos : nat64;
};
type ClaimBackingReceiptProgress = variant {
  AwaitingLiquidProof : ClaimBackingReceiptPermit;
  Pending;
  Completed : ClaimBackingReceiptResult;
  Stuck : text;
};
type RewardEventId = record {
  end_timestamp_seconds : nat64;
  round : nat64;
};
type RewardEventClassification = variant {
  ProposalBearing;
  NoProposalFallback;
  ZeroEligibleParticipation;
  MissedSkipped;
  StructuralOnly;
};
type FrozenEntitlement = record {
  sns_neuron_id : blob;
  destination : Account;
  accumulated_eligible_credit : nat;
};
type RewardEventObservation = record {
  event : RewardEventId;
  proposal_count : nat64;
  classification : RewardEventClassification;
  policy_credit : nat;
  eligible_credit_total : nat;
  observed_at_nanos : nat64;
};
type BackingNotReadyReason = variant {
  Paused;
  Busy;
  ReconciliationPending;
  BelowThreshold;
};
type RewardBackingProgress = variant {
  Pending : record { reason : BackingNotReadyReason };
  MaturityPrepared : record { generation : nat64 };
};
type StreamProgress = variant {
  Redemption : RedemptionProgress;
  ClaimReceipt : ClaimBackingReceiptProgress;
  BackingReconciliation;
  Idle;
};
type ApiError = variant {
  Anonymous;
  Unauthorized;
  Paused;
  Busy;
  Invalid : text;
  Ledger : text;
  Pending : text;
  Stuck : text;
};
type Status = record {
  lifecycle : Lifecycle;
  operation_kind : opt text;
  operation_phase : opt text;
  next_operation_sequence : nat64;
  redemption_staging_account : Account;
  pending_redemption_candidates : nat64;
  redemption_scan_status : AccountHistoryScanStatus;
  paid_unswept_redemption_io_e8s : opt nat;
  last_completed_redemption : opt RedemptionResult;
  latest_entitlement_batch_generation : nat64;
  latest_processed_reward_event : opt RewardEventId;
  latest_reward_event_classification : opt RewardEventClassification;
  accumulated_entitlements : vec FrozenEntitlement;
  accumulated_eligible_credit : nat;
  accumulated_policy_credit : nat;
  processed_reward_event_count : nat64;
  missed_reward_event_count : nat64;
  reward_work_due : bool;
  reward_processing_paused : bool;
  governance_parameters_fresh : bool;
  pending_entitlement_batch_eligible_credit : opt nat;
  pending_entitlement_batch_policy_credit : opt nat;
  latest_reconciliation_checkpoint : opt ReconciliationCheckpoint;
  prepared_exit_generation : opt nat64;
  prepared_exit_member_count : nat32;
  committed_exit_member_count : nat32;
};
type BlockIndex = record { nat64 };
type AccountHistoryScanStatus = record {
  last_success_timestamp_nanos : opt nat64;
  latest_page_unreadable_count : nat64;
  invariant_broken_count : nat64;
  last_observed_newest_tx_id : opt BlockIndex;
  last_observed_account_balance_e8s : opt nat;
  num_blocks_synced : opt BlockIndex;
  page_cap_reached : bool;
  lag_suspected : bool;
  scan_incomplete : bool;
  last_error : opt text;
  safe_to_continue : bool;
};
type ReconciliationCheckpoint = record {
  generation : nat64;
  event_marker : nat64;
  observed_at_nanos : nat64;
  claim_supply_e8s : nat;
  liquid_backing_e8s : nat;
  pooled_backing_e8s : nat;
  unwinding_backing_e8s : nat;
  transit_backing_e8s : nat;
  total_claim_backing_e8s : nat;
  active_backing_io_e8s : nat;
  active_reward_io_e8s : nat;
  live_cohort_count : nat32;
  oldest_ready_at_seconds : opt nat64;
  pooled_target_e8s : nat;
  observed_pooled_e8s : nat;
  snapshot_fingerprint : blob;
};
service : (InitArgs) -> {
  get_redemption_staging_account : () -> (Account) query;
  get_minimum_redemption_io_e8s : () -> (nat) query;
  process_redemptions : () -> (variant { Ok : RedemptionProgress; Err : ApiError });
  prepare_claim_backing_receipt : (PrepareClaimBackingReceiptArgs) -> (variant { Ok : ClaimBackingReceiptPermit; Err : ApiError });
  prove_claim_backing_receipt : (ProveClaimBackingReceiptArgs) -> (variant { Ok : ClaimBackingReceiptProgress; Err : ApiError });
  resume : () -> (variant { Ok : StreamProgress; Err : ApiError });
  prove_active_transfer : (nat) -> (variant { Ok; Err : ApiError });
  resume_reward_work : () -> (variant { Ok : RewardEventObservation; Err : ApiError });
  resume_reward_backing : () -> (variant { Ok : RewardBackingProgress; Err : ApiError });
  set_paused : (bool) -> (variant { Ok; Err : ApiError });
  validate_set_paused : (bool) -> (variant { Ok : text; Err : text }) query;
  get_status : () -> (Status) query;
}
